# Database
DATABASE_URL=postgresql://localhost:5432/humsafar

# AI / LLM Integration (Choose one provider)
GROQ_API_KEY=               # Free at https://console.groq.com (Recommended!)
GEMINI_API_KEY=             # Free at https://aistudio.google.com
DEEPSEEK_API_KEY=           # https://platform.deepseek.com
OPENROUTER_API_KEY=         # https://openrouter.ai
# Optional custom overrides: LLM_MODEL, LLM_BASE_URL, LLM_API_KEY

# Sarvam AI Voice Integration (Optional for core API, required for TTS / STT)
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu

# Public Node URL for QR code generation & App Links
PUBLIC_NODE_BASE_URL=https://humsafar.vercel.app/node
