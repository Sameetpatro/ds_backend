# Database
DATABASE_URL=postgresql://localhost:5432/humsafar

# AI / LLM Integration (DeepSeek or OpenRouter)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides: LLM_MODEL=deepseek-chat, LLM_BASE_URL=https://api.deepseek.com/v1

# Sarvam AI Voice Integration (Optional for core API, required for TTS / STT)
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu

# Public Node URL for QR code generation & App Links
PUBLIC_NODE_BASE_URL=https://humsafar.vercel.app/node
